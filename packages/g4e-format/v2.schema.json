{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:game4:ever-manifest:2",
  "title": "Game4 Ever Manifest v2 — G4EP",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format",
    "schemaVersion",
    "id",
    "representation",
    "contentId",
    "manifest",
    "g4ep",
    "discovery",
    "authentication"
  ],
  "properties": {
    "$schema": {
      "const": "urn:game4:ever-manifest:2"
    },
    "format": {
      "const": "game4-ever-manifest"
    },
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "$ref": "urn:game4:manifest:1#/properties/collection/properties/id"
    },
    "representation": {
      "const": "g4ep_fragments"
    },
    "contentId": {
      "type": "string",
      "pattern": "^urn:sha256:[0-9a-f]{64}$"
    },
    "manifest": {
      "allOf": [
        {
          "$ref": "urn:game4:manifest:1"
        },
        {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1
            },
            "extensions": {
              "type": "object",
              "maxProperties": 0
            }
          }
        }
      ]
    },
    "g4ep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "coding", "groups"],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "coding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codecId",
            "algorithm",
            "field",
            "fieldPolynomial",
            "rate",
            "symbolLayout",
            "dataShards",
            "parityShards",
            "shardBytes",
            "padding",
            "dataLayout",
            "recoveryIndexOffset"
          ],
          "properties": {
            "codecId": {
              "const": "g4ep-rs16-leopard-high-8-4-v1"
            },
            "algorithm": {
              "const": "reed-solomon"
            },
            "field": {
              "const": "gf(2^16)"
            },
            "fieldPolynomial": {
              "const": "0x1002d"
            },
            "rate": {
              "const": "high"
            },
            "symbolLayout": {
              "const": "leopard-64-byte-planes"
            },
            "dataShards": {
              "const": 8
            },
            "parityShards": {
              "const": 4
            },
            "shardBytes": {
              "type": "integer",
              "minimum": 65536,
              "maximum": 4194304,
              "multipleOf": 64
            },
            "padding": {
              "const": "zero"
            },
            "dataLayout": {
              "const": "contiguous-systematic"
            },
            "recoveryIndexOffset": {
              "const": 8
            }
          }
        },
        "groups": {
          "type": "array",
          "maxItems": 83333,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "index",
              "originalOffset",
              "originalBytes",
              "fragments"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^g[0-9]{12}$"
              },
              "index": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "originalOffset": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "originalBytes": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "fragments": {
                "type": "array",
                "minItems": 12,
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "index", "sizeBytes", "sha256"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^urn:sha256:[0-9a-f]{64}$"
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 11
                    },
                    "sizeBytes": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]{0,19})$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "discovery": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "nodeId", "endpoint"],
            "properties": {
              "kind": {
                "const": "private_peer"
              },
              "nodeId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "endpoint": {
                "type": "string",
                "minLength": 3,
                "maxLength": 100
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "fragmentId", "infoHashV1", "magnet"],
            "properties": {
              "kind": {
                "const": "bittorrent_fragment"
              },
              "fragmentId": {
                "type": "string",
                "pattern": "^urn:sha256:[0-9a-f]{64}$"
              },
              "infoHashV1": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "magnet": {
                "type": "string",
                "pattern": "^magnet:\\?xt=urn:btih:[0-9a-f]{40}$"
              }
            }
          }
        ]
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "payloadSha256", "signatures"],
      "properties": {
        "canonicalization": {
          "const": "game4-g4e-v2-canonical-json-v1"
        },
        "payloadSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signatures": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["algorithm", "keyId", "publicKey", "signature"],
            "properties": {
              "algorithm": {
                "const": "ed25519"
              },
              "keyId": {
                "type": "string",
                "pattern": "^urn:sha256:[0-9a-f]{64}$"
              },
              "publicKey": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "signature": {
                "type": "string",
                "pattern": "^[0-9a-f]{128}$"
              }
            }
          }
        }
      }
    }
  }
}
