{
  "name": "game4-infinity",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "apps/desktop",
    "packages/ipc-contracts"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev --workspace @game4/desktop",
    "desktop:dev": "npm run tauri --workspace @game4/desktop -- dev",
    "desktop:build": "npm run tauri --workspace @game4/desktop -- build",
    "build": "npm run build --workspace @game4/desktop",
    "check": "npm run typecheck --workspace @game4/desktop && npm run test --workspace @game4/desktop && npm run manifests:test && npm run g4:test && npm run g4e:test && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rust:check": "cargo check --locked --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check",
    "rust:test": "cargo test --locked --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "torrent:build": "cargo build --locked --manifest-path tools/torrent-probe/Cargo.toml",
    "torrent:probe": "cargo run --locked --manifest-path tools/torrent-probe/Cargo.toml --",
    "torrent:test": "cargo test --locked --manifest-path tools/torrent-probe/Cargo.toml",
    "torrent:check": "cargo fmt --manifest-path tools/torrent-probe/Cargo.toml -- --check && cargo clippy --locked --manifest-path tools/torrent-probe/Cargo.toml --all-targets -- -D warnings",
    "contracts:generate": "cargo run --locked --manifest-path apps/desktop/src-tauri/Cargo.toml --example export_contracts",
    "contracts:check": "cargo run --locked --manifest-path apps/desktop/src-tauri/Cargo.toml --example export_contracts -- --check",
    "manifests:test": "node --test packages/manifest-schema/test.mjs",
    "manifests:validate": "cargo run --locked --manifest-path apps/desktop/src-tauri/Cargo.toml --example validate_manifest --",
    "g4": "cargo run --locked --manifest-path apps/desktop/src-tauri/Cargo.toml --example g4 --",
    "g4:test": "node --test packages/g4-format/test.mjs",
    "g4e:test": "node --test packages/g4e-format/test.mjs",
    "g4e:validate": "node packages/g4e-format/validate.mjs",
    "g4e": "cargo run --locked --manifest-path apps/desktop/src-tauri/Cargo.toml --example ever --"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "prettier": "^3.6.2"
  }
}
